      "tool_timeout_sec": 120
    },
    "kcd2-native-probes": {
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "./scripts/Start-KCD2NativeProbesMcp.ps1"],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 120
    }
  }
}
