{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/manifest-log-schema-v1.schema.json",
  "title": "KCD2 manifest-declared generic log schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "event_name_field", "sequence", "events",
    "relations", "completion_markers", "redaction", "limits", "assertions"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.manifest-log-schema.v1"},
    "schema_id": {"$ref": "#/$defs/name"},
    "event_name_field": {"$ref": "#/$defs/name"},
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "start", "step", "required"],
      "properties": {
        "field": {"$ref": "#/$defs/name"},
        "start": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "step": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "required": {"type": "boolean"}
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/event"}
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_event", "parent_field", "child_event", "child_field"],
        "properties": {
          "parent_event": {"$ref": "#/$defs/name"},
          "parent_field": {"$ref": "#/$defs/name"},
          "child_event": {"$ref": "#/$defs/name"},
          "child_field": {"$ref": "#/$defs/name"}
        }
      }
    },
    "completion_markers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "minimum", "maximum"],
        "properties": {
          "event": {"$ref": "#/$defs/name"},
          "minimum": {"type": "integer", "minimum": 1, "maximum": 100000},
          "maximum": {"type": "integer", "minimum": 1, "maximum": 100000}
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_names", "replacement"],
      "properties": {
        "field_names": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "replacement": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_records", "maximum_line_bytes", "maximum_total_bytes",
        "maximum_unknown_events", "maximum_unknown_fields", "maximum_string_chars",
        "maximum_diagnostics"
      ],
      "properties": {
        "maximum_records": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maximum_line_bytes": {"type": "integer", "minimum": 256, "maximum": 8388608},
        "maximum_total_bytes": {"type": "integer", "minimum": 256, "maximum": 536870912},
        "maximum_unknown_events": {"type": "integer", "minimum": 0, "maximum": 256},
        "maximum_unknown_fields": {"type": "integer", "minimum": 0, "maximum": 128},
        "maximum_string_chars": {"type": "integer", "minimum": 1, "maximum": 65536},
        "maximum_diagnostics": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "assertions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "fieldType": {
      "enum": ["string", "integer", "number", "boolean", "null", "object", "array"]
    },
    "scalar": {
      "anyOf": [
        {"type": "string", "maxLength": 65536},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "number", "minimum": -1e308, "maximum": 1e308},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields", "required_fields", "redacted_fields", "maximum_events", "maximum_bytes"
      ],
      "properties": {
        "fields": {
          "type": "object", "maxProperties": 128,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/fieldType"}
        },
        "required_fields": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "redacted_fields": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "maximum_events": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "kind", "event"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/name"},
        "kind": {"enum": ["install", "fire", "count", "truncation", "cleanup", "sequence"]},
        "event": {"$ref": "#/$defs/name"},
        "then_event": {"$ref": "#/$defs/name"},
        "field": {"$ref": "#/$defs/name"},
        "equals": {"$ref": "#/$defs/scalar"},
        "minimum": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maximum": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "sequence"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["then_event"],
            "properties": {"then_event": {"$ref": "#/$defs/name"}}
          },
          "else": {"not": {"required": ["then_event"]}}
        }
      ]
    }
  }
}
