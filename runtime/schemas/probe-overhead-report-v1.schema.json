{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/probe-overhead-report-v1.schema.json",
  "title": "KCD2 probe overhead report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "measurement_window",
    "sources",
    "responsiveness",
    "severe_overhead",
    "capture_validity",
    "invalidation_reasons",
    "recommendation",
    "live_logging_change_requires_separate_approval",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "kcd2.probe-overhead-report.v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ns",
        "clock_resolution_ns",
        "clock",
        "method"
      ],
      "properties": {
        "duration_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000000
        },
        "clock_resolution_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000000
        },
        "clock": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "const": "precomputed_monotonic_aggregate"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "responsiveness": {
      "enum": [
        "responsive",
        "unresponsive",
        "not_observed"
      ]
    },
    "severe_overhead": {
      "type": "boolean"
    },
    "capture_validity": {
      "enum": [
        "complete",
        "capture_inconclusive"
      ]
    },
    "invalidation_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "responsiveness_not_confirmed",
          "severe_responsiveness_failure",
          "severe_timing_overhead",
          "source_loss_or_saturation"
        ]
      }
    },
    "recommendation": {
      "enum": [
        "KEEP_CURRENT",
        "REDUCE_TO_NORMAL",
        "REDUCE_TO_MINIMAL",
        "DISABLE_AFTER_VALIDATION",
        "CAPTURE_INVALID_OVERHEAD"
      ]
    },
    "live_logging_change_requires_separate_approval": {
      "const": true
    },
    "notes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "OFF",
        "MINIMAL",
        "NORMAL",
        "VERBOSE",
        "TRACE"
      ]
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_bound",
        "upper_bound",
        "basis",
        "decimal_places"
      ],
      "properties": {
        "lower_bound": {
          "type": "number",
          "minimum": 0
        },
        "upper_bound": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "enum": [
            "monotonic_interval",
            "aggregate_clock_resolution"
          ]
        },
        "decimal_places": {
          "const": 6
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "observed_events",
        "observed_bytes",
        "hook_callback_count",
        "dropped",
        "malformed",
        "truncated",
        "log_write_count",
        "log_flush_count",
        "saturated",
        "logging_level",
        "recommended_logging_level",
        "event_rate_per_second",
        "byte_rate_per_second",
        "callback_time_fraction",
        "rate_limit_exceeded",
        "severe_timing_overhead",
        "policy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_events": {
          "$ref": "#/$defs/counter"
        },
        "observed_bytes": {
          "$ref": "#/$defs/counter"
        },
        "hook_callback_count": {
          "$ref": "#/$defs/counter"
        },
        "dropped": {
          "$ref": "#/$defs/counter"
        },
        "malformed": {
          "$ref": "#/$defs/counter"
        },
        "truncated": {
          "$ref": "#/$defs/counter"
        },
        "log_write_count": {
          "$ref": "#/$defs/counter"
        },
        "log_flush_count": {
          "$ref": "#/$defs/counter"
        },
        "saturated": {
          "type": "boolean"
        },
        "logging_level": {
          "$ref": "#/$defs/level"
        },
        "recommended_logging_level": {
          "$ref": "#/$defs/level"
        },
        "event_rate_per_second": {
          "$ref": "#/$defs/interval"
        },
        "byte_rate_per_second": {
          "$ref": "#/$defs/interval"
        },
        "callback_time_fraction": {
          "oneOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_limit_exceeded": {
          "type": "boolean"
        },
        "severe_timing_overhead": {
          "type": "boolean"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_events_per_second",
            "max_bytes_per_second",
            "severe_callback_time_fraction"
          ],
          "properties": {
            "max_events_per_second": {
              "type": "number",
              "minimum": 0
            },
            "max_bytes_per_second": {
              "type": "number",
              "minimum": 0
            },
            "severe_callback_time_fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
