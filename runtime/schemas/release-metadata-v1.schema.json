{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/kcd2/release-metadata-v1.schema.json",
  "title": "KCD2 release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "release_id",
    "source_auditability",
    "components"
  ],
  "properties": {
    "$schema": {"const": "https://schemas.local/kcd2/release-metadata-v1.schema.json"},
    "schema_version": {"const": "kcd2.release-metadata.v1"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_auditability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "statement"],
      "properties": {
        "state": {
          "enum": ["source_complete", "source_partial", "runtime_only", "unknown"]
        },
        "statement": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "plugin_manifest",
        "deployment_manifest",
        "install_document",
        "install"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[^\\s]*$"},
        "plugin_manifest": {"$ref": "#/$defs/relativePath"},
        "deployment_manifest": {"$ref": "#/$defs/relativePath"},
        "install_document": {"$ref": "#/$defs/relativePath"},
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "steps"],
          "properties": {
            "summary": {"type": "string", "minLength": 1, "maxLength": 512},
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      }
    }
  }
}
