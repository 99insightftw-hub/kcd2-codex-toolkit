{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/crash-triage-report-v1.schema.json",
  "title": "KCD2 crash triage report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "incident_kind", "cross_tool_identity_id", "sources", "association", "last_events", "redaction", "coverage", "notes"],
  "properties": {
    "schema_version": {"const": "kcd2.crash-triage-report.v1"},
    "report_id": {"$ref": "#/$defs/id"},
    "incident_kind": {"enum": ["CRASH", "HANG"]},
    "cross_tool_identity_id": {"$ref": "#/$defs/id"},
    "sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source"}},
    "association": {"$ref": "#/$defs/association"},
    "last_events": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/event"}},
    "redaction": {"$ref": "#/$defs/redaction"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "notes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "state", "sha256"],
      "properties": {
        "source_type": {"enum": ["BUGSPLAT", "AFTERMATH", "MINIDUMP", "KCD_LOG", "WINDOWS_EVENT", "RUNTIME_SESSION", "MODULE_MAP", "DEPLOYMENT"]},
        "state": {"enum": ["AVAILABLE_PARSED", "AVAILABLE_UNSUPPORTED", "NOT_FOUND", "ERROR"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "module", "rva", "provider", "member", "confidence", "evidence_class"],
      "properties": {
        "level": {"enum": ["EXACT_EXCEPTION_MODULE_AND_RVA", "EXACT_ERROR_NAMES_PROVIDER_OR_MEMBER", "MEMBER_RESOLVED_TO_ACTIVE_PROVIDER", "TEMPORAL_ASSOCIATION_ONLY", "NO_SUPPORTED_ASSOCIATION", "INCONCLUSIVE_COVERAGE"]},
        "module": {"oneOf": [{"$ref": "#/$defs/module"}, {"type": "null"}]},
        "rva": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
        "provider": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "member": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidence_class": {"enum": ["static", "runtime", "user_confirmed", "causal"]}
      },
      "allOf": [
        {"if": {"properties": {"level": {"const": "EXACT_EXCEPTION_MODULE_AND_RVA"}}}, "then": {"properties": {"module": {"$ref": "#/$defs/module"}, "rva": {"type": "integer"}, "provider": {"type": "null"}, "member": {"type": "null"}}}},
        {"if": {"properties": {"level": {"const": "TEMPORAL_ASSOCIATION_ONLY"}}}, "then": {"properties": {"module": {"type": "null"}, "rva": {"type": "null"}, "provider": {"type": "null"}, "member": {"type": "null"}}}}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "session_time_ns", "summary", "association"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "session_time_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "summary": {"$ref": "#/$defs/text"},
        "association": {"const": "TEMPORAL_ASSOCIATION_ONLY"}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "categories", "sanitization"],
      "properties": {
        "applied": {"const": true},
        "categories": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "sanitization": {"const": "SANITIZED"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "claim_validity", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "claim_validity": {"enum": ["supported_for_reported_association", "capture_inconclusive"]},
        "gaps": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}
