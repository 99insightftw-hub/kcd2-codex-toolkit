{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/kcse-project-profile-v1.schema.json",
  "title": "KCD2 guarded KCSE project profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "module_name",
    "module_sha256",
    "module_timestamp",
    "module_image_size",
    "adapter_source",
    "adapter_source_sha256",
    "required_exports",
    "kcse_api_version"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.kcse-project-profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "module_name": {"const": "WHGame.dll"},
    "module_sha256": {"$ref": "#/$defs/sha256"},
    "module_timestamp": {"type": "string", "pattern": "^0x[A-Fa-f0-9]+$"},
    "module_image_size": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "adapter_source": {"type": "string", "minLength": 1, "maxLength": 4096},
    "adapter_source_sha256": {"$ref": "#/$defs/sha256"},
    "required_exports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}
    },
    "kcse_api_version": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
