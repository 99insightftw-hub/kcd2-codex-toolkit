{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/plugin-tool-surface-v1.schema.json",
  "title": "KCD2 direct plugin tool surface v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "source_revision", "tools"],
  "properties": {
    "schema_version": {"const": "kcd2.plugin-tool-surface.v1"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "json_schema": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 32,
      "required": ["$schema", "type", "additionalProperties", "properties"],
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64},
      "additionalProperties": true,
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "properties": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32
          }
        }
      }
    },
    "example_value": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
      "additionalProperties": true
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name", "operation_class", "exposure_status", "callable_via", "registered",
        "input_schema", "output_schema", "example", "approval_class", "library_binding",
        "output_bounds", "smoke_test", "not_exposed_reason"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "operation_class": {
          "enum": ["read_only_analysis", "build_write", "install_write", "rollback_write"]
        },
        "exposure_status": {"enum": ["REGISTERED", "NOT_EXPOSED_WITH_REASON"]},
        "callable_via": {"enum": ["mcp_plugin", "not_exposed"]},
        "registered": {"type": "boolean"},
        "input_schema": {"$ref": "#/$defs/json_schema"},
        "output_schema": {"$ref": "#/$defs/json_schema"},
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": {"$ref": "#/$defs/example_value"},
            "output": {"$ref": "#/$defs/example_value"}
          }
        },
        "approval_class": {"enum": ["none", "build", "install", "rollback"]},
        "library_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_or_symbol", "source_sha256"],
          "properties": {
            "module_or_symbol": {"type": "string", "minLength": 1, "maxLength": 256},
            "source_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
          }
        },
        "output_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_response_bytes", "artifact_spill"],
          "properties": {
            "max_response_bytes": {
              "type": "integer", "minimum": 256, "maximum": 1048576, "default": 65536
            },
            "artifact_spill": {"type": "boolean"}
          }
        },
        "smoke_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invoked_through_public_surface", "status", "receipt_id"],
          "properties": {
            "invoked_through_public_surface": {"type": "boolean"},
            "status": {"enum": ["passed", "failed", "not_run"]},
            "receipt_id": {
              "type": ["string", "null"], "minLength": 1, "maxLength": 256
            }
          }
        },
        "not_exposed_reason": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "reason"],
              "properties": {
                "code": {
                  "enum": ["INTERNAL_ONLY", "UNSUPPORTED", "INCOMPLETE_RELEASE", "UNSAFE_SURFACE"]
                },
                "reason": {"type": "string", "minLength": 12, "maxLength": 512}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"exposure_status": {"const": "REGISTERED"}}},
          "then": {
            "properties": {
              "registered": {"const": true},
              "callable_via": {"const": "mcp_plugin"},
              "not_exposed_reason": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "registered": {"const": false},
              "callable_via": {"const": "not_exposed"},
              "not_exposed_reason": {"type": "object"},
              "smoke_test": {
                "properties": {
                  "invoked_through_public_surface": {"const": false},
                  "status": {"const": "not_run"},
                  "receipt_id": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"operation_class": {"const": "read_only_analysis"}}},
          "then": {"properties": {"approval_class": {"const": "none"}}},
          "else": {
            "oneOf": [
              {
                "properties": {
                  "operation_class": {"const": "build_write"},
                  "approval_class": {"const": "build"}
                }
              },
              {
                "properties": {
                  "operation_class": {"const": "install_write"},
                  "approval_class": {"const": "install"}
                }
              },
              {
                "properties": {
                  "operation_class": {"const": "rollback_write"},
                  "approval_class": {"const": "rollback"}
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"exposure_status": {"const": "REGISTERED"}}},
          "then": {
            "properties": {
              "smoke_test": {
                "properties": {
                  "status": {"const": "passed"},
                  "receipt_id": {"type": "string"}
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"operation_class": {"const": "read_only_analysis"}}
                },
                "then": {
                  "properties": {
                    "smoke_test": {
                      "properties": {
                        "invoked_through_public_surface": {"const": true}
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "smoke_test": {
                      "properties": {
                        "invoked_through_public_surface": {"const": false}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
