{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/audio-haptic-runtime-receipt-v1.schema.json",
  "title": "KCD2 passive audio and haptic runtime receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "experiment_id", "active_snapshot_id", "adapter_id",
    "status", "evidence_layer", "event_count", "event_counts", "controller_types", "requests",
    "overlap", "cleanup", "haptics_preservation", "safety_gate", "limits", "reason_codes",
    "permitted_claims"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.audio-haptic-runtime-receipt.v1"},
    "session_id": {"$ref": "#/$defs/text"},
    "experiment_id": {"$ref": "#/$defs/text"},
    "active_snapshot_id": {"$ref": "#/$defs/text"},
    "adapter_id": {"$ref": "#/$defs/text"},
    "status": {"enum": ["complete", "capture_inconclusive"]},
    "evidence_layer": {"const": "runtime"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_counts": {
      "type": "object", "minProperties": 1, "maxProperties": 8,
      "propertyNames": {"enum": ["EVENT_FIRED", "ROUTE_SELECTED", "REQUEST_ADMITTED", "REQUEST_REJECTED", "HAPTIC_STARTED", "HAPTIC_ENDED", "FALLBACK_SELECTED", "SESSION_CLEANUP"]},
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4096}
    },
    "controller_types": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "requests": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/request"}},
    "overlap": {"$ref": "#/$defs/overlap"},
    "cleanup": {
      "type": "object", "additionalProperties": false, "required": ["state", "active_requests"],
      "properties": {"state": {"$ref": "#/$defs/text"}, "active_requests": {"type": "integer", "minimum": 0, "maximum": 4096}}
    },
    "haptics_preservation": {
      "type": "object", "additionalProperties": false,
      "required": ["dualsense_behavior", "evidence_layer", "reference", "capture_complete", "correlation_valid"],
      "properties": {
        "dualsense_behavior": {"enum": ["preserved", "unresolved"]},
        "evidence_layer": {"enum": ["static", "runtime", "user_confirmed", "causal"]},
        "reference": {"$ref": "#/$defs/text"},
        "capture_complete": {"type": "boolean"},
        "correlation_valid": {"type": "boolean"}
      }
    },
    "safety_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["passive", "action_map_unchanged", "input_not_synthesized", "input_not_consumed", "no_control_output"],
      "properties": {
        "passive": {"const": true}, "action_map_unchanged": {"const": true},
        "input_not_synthesized": {"const": true}, "input_not_consumed": {"const": true},
        "no_control_output": {"const": true}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_events", "maximum_payload_bytes", "maximum_duration_ms", "maximum_overlap_pairs"],
      "properties": {
        "maximum_events": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximum_payload_bytes": {"type": "integer", "minimum": 64, "maximum": 4096},
        "maximum_duration_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
        "maximum_overlap_pairs": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "reason_codes": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "permitted_claims": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "nullable_text": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "nullable_integer": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "nullable_number": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "fired_resource_id", "resource_kind", "selected_route_id", "admission", "rejection_reason", "controller_type", "duration_ms", "intensity", "fallback_route_id", "started_ns", "ended_ns", "cleanup_state"],
      "properties": {
        "request_id": {"$ref": "#/$defs/text"}, "fired_resource_id": {"$ref": "#/$defs/nullable_text"},
        "resource_kind": {"$ref": "#/$defs/nullable_text"}, "selected_route_id": {"$ref": "#/$defs/nullable_text"},
        "admission": {"enum": ["admitted", "rejected", "unresolved"]}, "rejection_reason": {"$ref": "#/$defs/nullable_text"},
        "controller_type": {"$ref": "#/$defs/nullable_text"}, "duration_ms": {"$ref": "#/$defs/nullable_integer"},
        "intensity": {"$ref": "#/$defs/nullable_number"}, "fallback_route_id": {"$ref": "#/$defs/nullable_text"},
        "started_ns": {"$ref": "#/$defs/nullable_integer"}, "ended_ns": {"$ref": "#/$defs/nullable_integer"},
        "cleanup_state": {"enum": ["complete", "unresolved"]}
      }
    },
    "overlap": {
      "type": "object", "additionalProperties": false, "required": ["status", "maximum_concurrent_requests", "pairs"],
      "properties": {
        "status": {"enum": ["measured", "unresolved"]},
        "maximum_concurrent_requests": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "pairs": {"type": "array", "maxItems": 65536, "items": {
          "type": "object", "additionalProperties": false, "required": ["request_ids", "overlap_duration_ns"],
          "properties": {"request_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "overlap_duration_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}}
        }}
      }
    }
  }
}
