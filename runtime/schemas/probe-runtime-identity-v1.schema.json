{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/probe-runtime-identity-v1.schema.json",
  "title": "KCD2 probe-emitted import-critical runtime identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "session_id", "emitted_at", "module", "game_version", "probe", "scope", "event_limits", "deployment_binding_sha256", "deployment_binding"],
  "properties": {
    "schema_version": {"const": "kcd2.probe-runtime-identity.v1"},
    "record_type": {"enum": ["INSTALL_OK", "CAPTURE_CLOSE"]},
    "session_id": {"type": "string", "pattern": "^session:[A-Za-z0-9_.:-]{1,247}$"},
    "emitted_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "base", "sha256", "timestamp", "image_size", "hook_rvas", "caller_rvas"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 260},
        "base": {"type": "string", "pattern": "^0x(?:0*[1-9A-Fa-f][A-Fa-f0-9]*)$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "timestamp": {"$ref": "#/$defs/hex"},
        "image_size": {"type": "integer", "minimum": 1},
        "hook_rvas": {"$ref": "#/$defs/rva_map"},
        "caller_rvas": {"$ref": "#/$defs/rva_map"}
      }
    },
    "game_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "probe": {"$ref": "#/$defs/probe_identity"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis", "enabled_hook_ids", "identity_matcher_ids", "event_families"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4000},
        "enabled_hook_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "identity_matcher_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "event_families": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    },
    "event_limits": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["maximum_events", "maximum_bytes"],
        "properties": {
          "maximum_events": {"type": "integer", "minimum": 1, "maximum": 100000},
          "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}
        }
      }
    },
    "deployment_binding_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_binding": {"$ref": "#/$defs/deployment_binding"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "hex": {"type": "string", "pattern": "^0x[A-Fa-f0-9]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "rva_map": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/hex"}
    },
    "probe_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "revision", "dll_sha256", "source_sha256", "contract_sha256"],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "dll_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "pe_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "timestamp", "image_size"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 260},
        "sha256": {"$ref": "#/$defs/sha256"},
        "timestamp": {"$ref": "#/$defs/hex"},
        "image_size": {"type": "integer", "minimum": 1}
      }
    },
    "deployment_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "binding_state", "deployment_id", "candidate_id", "active_snapshot_id", "active_snapshot_sha256", "snapshot_freshness", "target_mod", "target_pak", "target_manifest", "mod_order", "companion_components", "game", "probe", "verified_at_start", "verified_at_close", "start_fingerprint_sha256", "close_fingerprint_sha256", "identity_unchanged"],
      "properties": {
        "schema_version": {"const": "kcd2.runtime-deployment-binding.v1"},
        "binding_state": {"const": "EXACT"},
        "deployment_id": {"type": "string", "pattern": "^deploy:sha256:[A-Fa-f0-9]{64}$"},
        "candidate_id": {"type": "string", "pattern": "^cand:sha256:[A-Fa-f0-9]{64}$"},
        "active_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "active_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_freshness": {"const": "fresh_exact"},
        "target_mod": {
          "type": "object", "additionalProperties": false,
          "required": ["mod_id", "folder_name_exact"],
          "properties": {
            "mod_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "folder_name_exact": {"type": "string", "minLength": 1, "maxLength": 260}
          }
        },
        "target_pak": {"$ref": "#/$defs/file_identity"},
        "target_manifest": {"$ref": "#/$defs/file_identity"},
        "mod_order": {"$ref": "#/$defs/file_identity"},
        "companion_components": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1, "maxLength": 128},
              "path": {"type": "string", "minLength": 1, "maxLength": 2048},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "game": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "executable", "whgame"],
          "properties": {
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "executable": {"$ref": "#/$defs/pe_identity"},
            "whgame": {"$ref": "#/$defs/pe_identity"}
          }
        },
        "probe": {"$ref": "#/$defs/probe_identity"},
        "verified_at_start": {"type": "string", "format": "date-time"},
        "verified_at_close": {"type": "string", "format": "date-time"},
        "start_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "close_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "identity_unchanged": {"const": true}
      }
    }
  }
}
