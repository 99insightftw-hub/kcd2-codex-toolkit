{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/table-semantics-profile-v1.schema.json",
  "title": "KCD2 table semantics profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "game_build",
    "source_build",
    "table_name",
    "path_patterns",
    "record_path",
    "table_type",
    "primary_keys",
    "patch_behavior",
    "omission_behavior",
    "list_behavior",
    "case_sensitive",
    "schema_paths",
    "reference_fields",
    "tbl_requirement"
  ],
  "properties": {
    "schema_version": {
      "const": "kcd2.table-semantics-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "game_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "table_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "path_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "record_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "table_type": {
      "enum": [
        "old",
        "new",
        "unsupported_replace_only",
        "do_not_change",
        "unused",
        "unknown"
      ]
    },
    "primary_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "patch_behavior": {
      "enum": [
        "full_row_required",
        "partial_row_merge",
        "replace_whole_file",
        "not_supported",
        "unknown"
      ]
    },
    "omission_behavior": {
      "enum": [
        "preserve_previous",
        "remove_previous",
        "invalid",
        "unknown"
      ]
    },
    "list_behavior": {
      "enum": [
        "append",
        "per_item_patch",
        "replace",
        "not_applicable",
        "unknown"
      ]
    },
    "case_sensitive": {
      "type": "boolean"
    },
    "schema_paths": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "reference_fields": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "target_family"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "tbl_requirement": {
      "enum": [
        "TBL_REQUIRED_AND_MATCHED",
        "TBL_NOT_REQUIRED_WITH_EVIDENCE",
        "TBL_REQUIREMENT_UNKNOWN"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "table_type"
        ],
        "properties": {
          "table_type": {
            "const": "old"
          }
        }
      },
      "then": {
        "properties": {
          "patch_behavior": {
            "const": "full_row_required"
          },
          "omission_behavior": {
            "const": "invalid"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "table_type",
          "patch_behavior"
        ],
        "properties": {
          "table_type": {
            "const": "new"
          },
          "patch_behavior": {
            "const": "partial_row_merge"
          }
        }
      },
      "then": {
        "properties": {
          "omission_behavior": {
            "const": "preserve_previous"
          }
        }
      }
    }
  ]
}
