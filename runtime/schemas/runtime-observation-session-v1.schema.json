{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/runtime-observation-session-v1.schema.json",
  "title": "KCD2 gameplay observation session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "cross_tool_identity",
    "latest_boot_id",
    "candidate_sha256",
    "deployment_sha256",
    "source_sha256",
    "started_at",
    "closed_at",
    "matrix_id",
    "test_case",
    "steps",
    "assertions",
    "completeness",
    "result",
    "session_binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.runtime-observation-session.v1"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "cross_tool_identity": {"$ref": "cross-tool-identity-v1.schema.json"},
    "latest_boot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": "string", "format": "date-time"},
    "matrix_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "test_case": {"type": "string", "minLength": 1, "maxLength": 256},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/step"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "completeness": {
      "enum": ["COMPLETE", "INCOMPLETE", "TRUNCATED", "IDENTITY_DRIFT", "UNKNOWN"]
    },
    "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "session_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "domain": {
      "enum": [
        "inventory",
        "processing",
        "prompts",
        "animations",
        "items",
        "localization",
        "ui",
        "icons",
        "stats",
        "project_assertions"
      ]
    },
    "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "domain", "instruction", "expected", "actual", "status"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "domain": {"$ref": "#/$defs/domain"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 2048},
        "expected": {},
        "actual": {},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "name", "expected", "actual", "status"],
      "properties": {
        "domain": {"$ref": "#/$defs/domain"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "expected": {},
        "actual": {},
        "status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
