{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/prepare-test-readiness-v1.schema.json",
  "title": "KCD2 prepare-test aggregate readiness receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "investigation_id", "identity_id", "expected_head_transition_sha256", "experiment_id", "status", "decision", "distinguishing_variable_observed", "checks", "missing_channels", "blockers", "delegated_receipt_ids", "test_matrix", "gameplay_requested"],
  "properties": {
    "schema_version": {"const": "kcd2.prepare-test-readiness.v1"},
    "receipt_id": {"type": "string", "pattern": "^prepare-test:sha256:[0-9a-f]{64}$"},
    "investigation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "identity_id": {"type": "string", "pattern": "^identity:sha256:[0-9a-f]{64}$"},
    "expected_head_transition_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["READY", "BLOCKED"]},
    "decision": {"enum": ["READY_FOR_TEST", "BLOCKED"]},
    "distinguishing_variable_observed": {"type": "boolean"},
    "checks": {"type": "object", "additionalProperties": false, "required": ["static", "deployment", "observation_channels", "debugger", "controls", "limits", "cleanup"], "properties": {"static": {"type": "boolean"}, "deployment": {"type": "boolean"}, "observation_channels": {"type": "boolean"}, "debugger": {"type": "boolean"}, "controls": {"type": "boolean"}, "limits": {"type": "boolean"}, "cleanup": {"type": "boolean"}}},
    "missing_channels": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "blockers": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "delegated_receipt_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "gameplay_requested": {"const": false},
    "test_matrix": {"$ref": "#/$defs/test_matrix"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "test_matrix": {"type": "object", "additionalProperties": false, "required": ["experiment_id", "hypothesis_ids", "required_channels", "controls", "bounds", "outcome_ids", "stop_conditions", "cleanup_requirements", "gameplay_requested"], "properties": {
      "experiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
      "hypothesis_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
      "required_channels": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
      "controls": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
      "bounds": {"type": "object", "additionalProperties": false, "required": ["maximum_attempts", "maximum_duration_seconds", "maximum_events"], "properties": {"maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 100}, "maximum_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "maximum_events": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
      "outcome_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
      "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
      "cleanup_requirements": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/text"}},
      "gameplay_requested": {"const": false}
    }}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "READY"}}, "required": ["status"]}, "then": {"properties": {"decision": {"const": "READY_FOR_TEST"}, "blockers": {"maxItems": 0}, "missing_channels": {"maxItems": 0}, "distinguishing_variable_observed": {"const": true}}}},
    {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"decision": {"const": "BLOCKED"}, "blockers": {"minItems": 1}}}}
  ]
}
