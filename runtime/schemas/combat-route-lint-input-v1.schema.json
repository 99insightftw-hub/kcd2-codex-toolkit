{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/combat-route-lint-input-v1.schema.json",
  "title": "KCD2 reviewed combat route lint input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "required_modes", "required_orientations", "route_families"],
  "properties": {
    "schema_version": {"const": "kcd2.combat-route-lint-input.v1"},
    "model_id": {"$ref": "#/$defs/text"},
    "required_modes": {"$ref": "#/$defs/matrix_values"},
    "required_orientations": {"$ref": "#/$defs/matrix_values"},
    "route_families": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000]+$"},
    "matrix_values": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "values": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "party_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["weapon_classes", "weapon_items", "shield_states", "actor_kinds"],
      "properties": {
        "weapon_classes": {"$ref": "#/$defs/values"},
        "weapon_items": {"$ref": "#/$defs/values"},
        "shield_states": {"$ref": "#/$defs/values"},
        "actor_kinds": {"$ref": "#/$defs/values"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "opponent"],
      "properties": {"actor": {"$ref": "#/$defs/party_scope"}, "opponent": {"$ref": "#/$defs/party_scope"}}
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["node_id", "terminal"],
      "properties": {"node_id": {"$ref": "#/$defs/text"}, "terminal": {"type": "boolean"}}
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["source", "target", "kind"],
      "properties": {
        "source": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["transition", "cancel", "exit", "timeout"]}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["route_id", "mode", "orientation", "source_role", "target_role", "provider_id", "provider_contributes_required_route", "entry_node_id", "reachable_scope", "nodes", "edges"],
      "properties": {
        "route_id": {"$ref": "#/$defs/text"}, "mode": {"$ref": "#/$defs/text"},
        "orientation": {"$ref": "#/$defs/text"}, "source_role": {"$ref": "#/$defs/text"},
        "target_role": {"$ref": "#/$defs/text"}, "provider_id": {"$ref": "#/$defs/text"},
        "provider_contributes_required_route": {"type": "boolean"},
        "entry_node_id": {"$ref": "#/$defs/text"}, "reachable_scope": {"$ref": "#/$defs/scope"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "maxItems": 250000, "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "interaction_kind", "symmetry_required", "active_provider_id", "intended_scope", "routes"],
      "properties": {
        "family_id": {"$ref": "#/$defs/text"},
        "interaction_kind": {"enum": ["combat_sync", "combat_action", "non_combat_sync"]},
        "symmetry_required": {"type": "boolean"}, "active_provider_id": {"$ref": "#/$defs/text"},
        "intended_scope": {"$ref": "#/$defs/scope"},
        "routes": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/route"}}
      }
    }
  }
}
