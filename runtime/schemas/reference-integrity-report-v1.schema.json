{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/reference-integrity-report-v1.schema.json",
  "title": "KCD2 bounded reference integrity report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "input_sha256",
    "status",
    "coverage",
    "bounds",
    "graph",
    "resolutions"
  ],
  "properties": {
    "schema_version": { "const": "kcd2.reference-integrity-report.v1" },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": {
      "enum": ["resolved", "issues_found", "capture_inconclusive"]
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "graph": { "$ref": "#/$defs/graph" },
    "resolutions": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/resolution" }
    }
  },
  "$defs": {
    "family": {
      "enum": [
        "table",
        "localization",
        "asset",
        "lua",
        "quest",
        "xsd",
        "smart_object",
        "animation"
      ]
    },
    "classification": {
      "enum": [
        "resolved_active",
        "missing_globally",
        "missing_from_active_set",
        "available_only_in_dependency",
        "defined_by_later_mod",
        "defined_wrong_case",
        "ambiguous_duplicate_definition",
        "capture_inconclusive"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_id",
        "overall_status",
        "absence_claim_allowed",
        "reason_codes"
      ],
      "properties": {
        "coverage_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "overall_status": {
          "enum": [
            "COMPLETE",
            "COMPLETE_FOR_REQUESTED_SCOPE",
            "PARTIAL_LIMIT_REACHED",
            "PARTIAL_STALE",
            "INCONCLUSIVE",
            "UNAVAILABLE"
          ]
        },
        "absence_claim_allowed": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_definitions",
        "max_references",
        "max_matches_per_reference",
        "max_edges",
        "definitions_considered",
        "references_considered"
      ],
      "properties": {
        "max_definitions": { "const": 20000 },
        "max_references": { "const": 20000 },
        "max_matches_per_reference": { "const": 256 },
        "max_edges": { "const": 100000 },
        "definitions_considered": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "references_considered": { "type": "integer", "minimum": 0, "maximum": 20000 }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "family",
        "key",
        "provider_id",
        "provider_kind",
        "source_path",
        "active",
        "dependency",
        "load_order_index"
      ],
      "properties": {
        "definition_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "family": { "$ref": "#/$defs/family" },
        "key": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "provider_kind": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "active": { "type": "boolean" },
        "dependency": { "type": "boolean" },
        "load_order_index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "family",
        "target",
        "provider_id",
        "source_path",
        "load_order_index"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "family": { "$ref": "#/$defs/family" },
        "target": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "load_order_index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "definition_id", "classification"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "definition_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions", "references", "edges"],
      "properties": {
        "definitions": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/definition" }
        },
        "references": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/reference" }
        },
        "edges": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "matched_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "defined_key",
        "provider_id",
        "active",
        "dependency",
        "load_order_index"
      ],
      "properties": {
        "definition_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "defined_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "active": { "type": "boolean" },
        "dependency": { "type": "boolean" },
        "load_order_index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "family",
        "target",
        "classification",
        "reason_codes",
        "matched_definitions"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "family": { "$ref": "#/$defs/family" },
        "target": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "classification": { "$ref": "#/$defs/classification" },
        "reason_codes": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "matched_definitions": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/matched_definition" }
        }
      }
    }
  }
}
