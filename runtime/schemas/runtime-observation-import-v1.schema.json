{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/runtime-observation-import-v1.schema.json",
  "title": "KCD2 typed runtime observation import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "observation_count",
    "session_ids",
    "semantic_type_counts",
    "source_kind_counts",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.runtime-observation-import.v1"},
    "status": {"enum": ["complete", "capture_inconclusive"]},
    "observation_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "session_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "semantic_type_counts": {"$ref": "#/$defs/counts"},
    "source_kind_counts": {"$ref": "#/$defs/counts"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "semantic_type": {
      "enum": [
        "FUNCTION_ENTRY",
        "FUNCTION_RETURN",
        "FIELD_READ",
        "FIELD_WRITE",
        "SELECTOR_INPUT",
        "CANDIDATE_COUNT",
        "SELECTED_RECORD",
        "NULL_SELECTION",
        "SCRIPT_EVENT",
        "UI_EVENT",
        "USER_VISIBLE_BEHAVIOR",
        "NEGATIVE_OBSERVATION",
        "CRASH_OR_HANG",
        "CAUSAL_INFERENCE",
        "LEGACY_UNKNOWN"
      ]
    },
    "source_kind": {
      "enum": ["NATIVE", "SCRIPT", "UI", "USER", "NEGATIVE", "CRASH", "CAUSAL", "LEGACY"]
    },
    "evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "unknown"]},
    "counts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 10000}
    },
    "payload": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {}
    },
    "negative_validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "probe_id",
        "session_id",
        "checks",
        "event_family_saturation",
        "verdict",
        "reasons",
        "permitted_runtime_claims"
      ],
      "properties": {
        "schema_version": {"const": "kcd2.probe-result-validity.v1"},
        "probe_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "checks": {
          "type": "object",
          "minProperties": 13,
          "maxProperties": 13,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"type": "boolean"}
        },
        "event_family_saturation": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observed", "limit", "reached"],
            "properties": {
              "observed": {"type": "integer", "minimum": 0, "maximum": 100000},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100000},
              "reached": {"type": "boolean"}
            }
          }
        },
        "verdict": {"enum": ["confirmed_negative_in_covered_scope", "capture_inconclusive"]},
        "reasons": {
          "type": "array",
          "maxItems": 512,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "permitted_runtime_claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "audit_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_operation", "reason"],
      "properties": {
        "original_operation": {"const": "unknown"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "session_id",
        "sequence",
        "monotonic_ns",
        "semantic_type",
        "source_kind",
        "event_name",
        "evidence_grade",
        "payload",
        "negative_validity",
        "legacy"
      ],
      "properties": {
        "schema_version": {"const": "kcd2.runtime-observation.v1"},
        "observation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "monotonic_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "semantic_type": {"$ref": "#/$defs/semantic_type"},
        "source_kind": {"$ref": "#/$defs/source_kind"},
        "event_name": {"$ref": "#/$defs/name"},
        "evidence_grade": {"$ref": "#/$defs/evidence_grade"},
        "payload": {"$ref": "#/$defs/payload"},
        "negative_validity": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/negative_validity"}]
        },
        "legacy": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/legacy"}]}
      }
    }
  }
}
