{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/runtime-jsonl-v1.schema.json",
  "title": "KCD2 canonical runtime JSONL v1 record",
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["schema_version", "record_type", "session_id", "sequence", "emitted_at", "producer", "environment_fingerprint_sha256", "deployment_binding_sha256", "declared_event_families", "limits", "extensions"], "properties": {"schema_version": {"const": "kcd2.runtime-jsonl.v1"}, "record_type": {"const": "session_start"}, "session_id": {"$ref": "#/$defs/session_id"}, "sequence": {"const": 0}, "emitted_at": {"$ref": "#/$defs/date_time"}, "producer": {"type": "string", "minLength": 1, "maxLength": 256}, "environment_fingerprint_sha256": {"$ref": "#/$defs/sha256"}, "deployment_binding_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "declared_event_families": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "limits": {"$ref": "#/$defs/limits"}, "extensions": {"$ref": "#/$defs/extensions"}}},
    {"type": "object", "additionalProperties": false, "required": ["schema_version", "record_type", "session_id", "sequence", "emitted_at", "event_family", "event_name", "monotonic_ns", "payload", "extensions"], "properties": {"schema_version": {"const": "kcd2.runtime-jsonl.v1"}, "record_type": {"const": "event"}, "session_id": {"$ref": "#/$defs/session_id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 100000}, "emitted_at": {"$ref": "#/$defs/date_time"}, "event_family": {"type": "string", "minLength": 1, "maxLength": 128}, "event_name": {"type": "string", "minLength": 1, "maxLength": 128}, "monotonic_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "payload": {"$ref": "#/$defs/extensions"}, "extensions": {"$ref": "#/$defs/extensions"}}},
    {"type": "object", "additionalProperties": false, "required": ["schema_version", "record_type", "session_id", "sequence", "emitted_at", "event_counts", "dropped_events", "truncated", "completeness", "truncation_reasons", "extensions"], "properties": {"schema_version": {"const": "kcd2.runtime-jsonl.v1"}, "record_type": {"const": "session_end"}, "session_id": {"$ref": "#/$defs/session_id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 100001}, "emitted_at": {"$ref": "#/$defs/date_time"}, "event_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100000}, "maxProperties": 128, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128}}, "dropped_events": {"type": "integer", "minimum": 0, "maximum": 100000}, "truncated": {"type": "boolean"}, "completeness": {"enum": ["complete", "truncated", "dropped_events", "capture_inconclusive"]}, "truncation_reasons": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "extensions": {"$ref": "#/$defs/extensions"}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "session_id": {"type": "string", "pattern": "^session:[A-Za-z0-9_.:-]{1,247}$"},
    "date_time": {"type": "string", "format": "date-time", "maxLength": 64},
    "scalar": {"anyOf": [{"type": "string", "maxLength": 65536}, {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}, {"type": "number", "minimum": -1e308, "maximum": 1e308}, {"type": "boolean"}, {"type": "null"}]},
    "extension_value": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/scalar"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}, "maxProperties": 128, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128}}]},
    "extensions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/extension_value"}, "maxProperties": 128, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_records", "max_line_bytes", "max_total_bytes", "max_string_chars", "max_extension_fields"], "properties": {"max_records": {"type": "integer", "minimum": 1, "default": 10000, "maximum": 100000}, "max_line_bytes": {"type": "integer", "minimum": 256, "default": 1048576, "maximum": 8388608}, "max_total_bytes": {"type": "integer", "minimum": 256, "default": 67108864, "maximum": 536870912}, "max_string_chars": {"type": "integer", "minimum": 1, "default": 4096, "maximum": 65536}, "max_extension_fields": {"type": "integer", "minimum": 0, "default": 32, "maximum": 128}}}
  }
}
