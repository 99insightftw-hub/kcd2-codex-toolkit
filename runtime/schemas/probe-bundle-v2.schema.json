{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/probe-bundle-v2.schema.json",
  "title": "KCD2 bounded probe evidence bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_at", "probe_id", "revision", "stage", "carrier", "hypothesis", "user_action", "environment_fingerprint_sha256", "deployment_binding_sha256", "module", "module_base", "locations", "observations", "captures", "result", "completeness", "truncation_reasons", "evidence_refs", "limits", "debugger_handoff", "cleanup"],
  "properties": {
    "schema_version": {"const": "kcd2.probe-bundle.v2"},
    "bundle_id": {"type": "string", "pattern": "^probe-bundle:sha256:[A-Fa-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "probe_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "stage": {"enum": ["plan", "capture_ready", "captured", "final", "import_ready"]},
    "carrier": {"enum": ["x64dbg", "kcse", "hybrid", "lua"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4000},
    "user_action": {"type": "string", "minLength": 1, "maxLength": 4000},
    "environment_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_binding_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "module": {"$ref": "#/$defs/module_identity"},
    "module_base": {"type": ["string", "null"], "pattern": "^0x[A-Fa-f0-9]{1,16}$"},
    "locations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["module_sha256", "rva", "absolute", "purpose"], "properties": {"module_sha256": {"$ref": "#/$defs/sha256"}, "rva": {"$ref": "#/$defs/hex_address"}, "absolute": {"type": ["string", "null"], "pattern": "^0x[A-Fa-f0-9]{1,16}$"}, "purpose": {"type": "string", "minLength": 1, "maxLength": 1000}}}},
    "observations": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["subject", "module_sha256", "rva", "observation_type", "confirmed", "fields"], "properties": {"subject": {"type": "string", "minLength": 1, "maxLength": 256}, "module_sha256": {"$ref": "#/$defs/sha256"}, "rva": {"$ref": "#/$defs/hex_address"}, "observation_type": {"type": "string", "minLength": 1, "maxLength": 128}, "confirmed": {"type": "boolean"}, "fields": {"$ref": "#/$defs/extension_map"}}}},
    "captures": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["capture_id", "source", "event", "thread_id", "timestamp", "module_sha256", "rip_rva", "registers", "fields", "object_memory"], "properties": {"capture_id": {"type": "string", "minLength": 1, "maxLength": 128}, "source": {"enum": ["x64dbg", "kcse", "lua"]}, "event": {"type": "string", "minLength": 1, "maxLength": 128}, "thread_id": {"type": ["string", "null"], "maxLength": 64}, "timestamp": {"type": ["string", "null"], "format": "date-time", "maxLength": 64}, "module_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "rip_rva": {"type": ["string", "null"], "pattern": "^0x[A-Fa-f0-9]{1,16}$"}, "registers": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^0x[A-Fa-f0-9]{1,16}$"}, "maxProperties": 64, "propertyNames": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$"}}, "fields": {"$ref": "#/$defs/extension_map"}, "object_memory": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["module_sha256", "base_rva", "bytes", "bytes_hex", "sha256"], "properties": {"module_sha256": {"$ref": "#/$defs/sha256"}, "base_rva": {"$ref": "#/$defs/hex_address"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 4096}, "bytes_hex": {"type": "string", "pattern": "^[A-Fa-f0-9]{2,8192}$"}, "sha256": {"$ref": "#/$defs/sha256"}}}}}}},
    "result": {"enum": ["positive_observation", "confirmed_negative_in_covered_scope", "capture_inconclusive", "not_evaluated"]},
    "completeness": {"enum": ["complete", "partial", "truncated", "dropped_events", "capture_inconclusive"]},
    "truncation_reasons": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "evidence_refs": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "limits": {"$ref": "#/$defs/limits"},
    "debugger_handoff": {"type": "object", "additionalProperties": false, "required": ["requested", "debugger_state", "debugging", "running", "resumed_at", "verified_at", "minimum_delay_ms", "gameplay_eligible"], "properties": {"requested": {"type": "boolean"}, "debugger_state": {"$ref": "#/$defs/debugger_state"}, "debugging": {"type": ["boolean", "null"]}, "running": {"type": ["boolean", "null"]}, "resumed_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 64}, "verified_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 64}, "minimum_delay_ms": {"type": "integer", "minimum": 750, "maximum": 60000}, "gameplay_eligible": {"type": "boolean"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["game_running", "breakpoints_cleared", "debugger_state", "temporary_probe_removed", "raw_log_archived"], "properties": {"game_running": {"type": "boolean"}, "breakpoints_cleared": {"type": ["boolean", "null"]}, "debugger_state": {"$ref": "#/$defs/debugger_state"}, "temporary_probe_removed": {"type": ["boolean", "null"]}, "raw_log_archived": {"type": "boolean"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "debugger_state": {"enum": ["unknown", "not_running", "detached", "connected_paused", "connected_running", "not_applicable"]},
    "hex_address": {"type": "string", "pattern": "^0x[A-Fa-f0-9]{1,16}$"},
    "module_identity": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "pe_timestamp", "image_size"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 260}, "sha256": {"$ref": "#/$defs/sha256"}, "pe_timestamp": {"$ref": "#/$defs/hex_address"}, "image_size": {"type": "integer", "minimum": 1, "maximum": 1099511627776}}},
    "scalar": {"oneOf": [{"type": "string", "maxLength": 65536}, {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}, {"type": "boolean"}, {"type": "null"}]},
    "extension_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}, "maxProperties": 128, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_events", "max_captures", "max_event_families", "max_total_bytes", "max_fields", "max_string_chars", "max_memory_region_bytes"], "properties": {"max_events": {"type": "integer", "minimum": 1, "default": 10000, "maximum": 100000}, "max_captures": {"type": "integer", "minimum": 1, "default": 1000, "maximum": 10000}, "max_event_families": {"type": "integer", "minimum": 1, "default": 32, "maximum": 128}, "max_total_bytes": {"type": "integer", "minimum": 1024, "default": 67108864, "maximum": 536870912}, "max_fields": {"type": "integer", "minimum": 1, "default": 32, "maximum": 128}, "max_string_chars": {"type": "integer", "minimum": 1, "default": 4096, "maximum": 65536}, "max_memory_region_bytes": {"type": "integer", "minimum": 1, "default": 4096, "maximum": 4096}}}
  }
}
