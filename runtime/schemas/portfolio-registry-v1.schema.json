{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/portfolio-registry-v1.schema.json",
  "title": "KCD2 content-addressed portfolio registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "aliases",
    "observed_at",
    "coverage",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": "kcd2.portfolio-registry.v1"
    },
    "registry_id": {
      "$ref": "#/$defs/registry_id"
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "registry_id": {
      "type": "string",
      "pattern": "^registry:sha256:[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project:sha256:[0-9a-f]{64}$"
    },
    "aliases": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "machine_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\u0000]+(?<!/)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "absence_claim_valid",
        "notes"
      ],
      "properties": {
        "state": {
          "enum": [
            "COMPLETE",
            "PARTIAL_LIMIT_REACHED",
            "PARTIAL_STALE",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "absence_claim_valid": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "aliases",
        "kind"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "pattern": "^domain:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "kind": {
          "$ref": "#/$defs/machine_kind"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "aliases",
        "kind",
        "locator",
        "state",
        "sha256"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^provider:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "kind": {
          "enum": [
            "LOCAL",
            "WORKSHOP",
            "SOURCE_PROJECT",
            "REFERENCE",
            "EXTERNAL_COMPONENT"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "aliases",
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "expected_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "aliases",
        "kind",
        "required",
        "paths"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^component:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "kind": {
          "$ref": "#/$defs/machine_kind"
        },
        "required": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "path",
        "role"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "pattern": "^path:sha256:[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "table_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_key_id",
        "table_path",
        "key_fields"
      ],
      "properties": {
        "table_key_id": {
          "type": "string",
          "pattern": "^table-key:sha256:[0-9a-f]{64}$"
        },
        "table_path": {
          "$ref": "#/$defs/relative_path"
        },
        "key_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "aliases",
        "kind",
        "requirement",
        "target_paths"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^test:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "kind": {
          "$ref": "#/$defs/machine_kind"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "target_paths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        }
      }
    },
    "conflict_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_intent_id",
        "aliases",
        "scope",
        "path",
        "intent",
        "statement"
      ],
      "properties": {
        "conflict_intent_id": {
          "type": "string",
          "pattern": "^conflict-intent:sha256:[0-9a-f]{64}$"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "scope": {
          "enum": [
            "PROJECT",
            "PATH"
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/relative_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent": {
          "enum": [
            "INTENDED_WINNER",
            "INTENDED_MERGE",
            "PROTECTED_UPSTREAM",
            "IDENTICAL_MIRROR",
            "UNRESOLVED"
          ]
        },
        "statement": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "const": "PROJECT"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "const": "PATH"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "aliases",
        "domains",
        "providers",
        "artifacts",
        "expected_components",
        "paths",
        "table_keys",
        "tests",
        "conflict_intent",
        "relationships",
        "variants",
        "supported_game_builds"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/project_id"
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "providers": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "expected_components": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expected_component"
          }
        },
        "paths": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "table_keys": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/table_key"
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "conflict_intent": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/conflict_intent"
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "variants": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "supported_game_builds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
