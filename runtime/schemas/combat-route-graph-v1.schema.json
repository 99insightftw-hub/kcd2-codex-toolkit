{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/combat-route-graph-v1.schema.json",
  "title": "KCD2 compiled combat route graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "input_mode", "snapshot_id", "coverage_id",
    "status", "identity", "source_handles", "nodes", "edges",
    "pairing_orientation_matrix", "coverage_gaps", "summary"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.combat-route-graph.v1"},
    "request_id": {"$ref": "#/$defs/text"},
    "input_mode": {"const": "automatic"},
    "snapshot_id": {"$ref": "#/$defs/text"},
    "coverage_id": {"$ref": "#/$defs/text"},
    "status": {"enum": ["resolved", "capture_inconclusive"]},
    "identity": {"type": "object"},
    "source_handles": {
      "type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_handle"}
    },
    "nodes": {
      "type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/edge"}
    },
    "pairing_orientation_matrix": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/matrix_row"}
    },
    "coverage_gaps": {
      "type": "array", "maxItems": 1048576, "items": {"$ref": "#/$defs/gap"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "text": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^\\u0000]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_handle": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_handle", "sha256", "acquisition"],
      "properties": {
        "kind": {"$ref": "#/$defs/text"},
        "source_handle": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "acquisition": {"enum": ["inline", "fallback"]}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "kind", "label", "identity", "claim_state"],
      "properties": {
        "node_id": {"$ref": "#/$defs/text"},
        "kind": {
          "enum": [
            "pairing", "route", "table_row", "adb_fragment", "animation_alias",
            "animation_clip", "dba_container", "animation_event", "native_symbol",
            "provider", "runtime_observation", "evidence_source", "coverage_gap"
          ]
        },
        "label": {"$ref": "#/$defs/text"},
        "identity": {"$ref": "#/$defs/text"},
        "claim_state": {"enum": ["proposed", "supported", "confirmed", "inconclusive"]}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source", "target", "kind", "state", "evidence_layer",
        "evidence_refs", "unknown_reason"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"},
        "kind": {
          "enum": [
            "pairing_has_route", "route_uses_table_row", "route_uses_fragment",
            "fragment_references_clip", "clip_owned_by_dba", "alias_names_clip",
            "fragment_selects_alias", "clip_emits_event", "route_active_provider",
            "route_observed_at_runtime", "native_supported_by_evidence",
            "pairing_has_coverage_gap"
          ]
        },
        "state": {"enum": ["supported", "unknown", "inconclusive"]},
        "evidence_layer": {"enum": ["static", "runtime", "user_confirmed", "causal", "coverage"]},
        "evidence_refs": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "unknown_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
      }
    },
    "gate_state": {"enum": ["supported", "unknown", "inconclusive"]},
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "table", "adb", "alias_existence", "alias_selectability", "animation",
        "event", "provider", "native", "runtime"
      ],
      "properties": {
        "table": {"$ref": "#/$defs/gate_state"},
        "adb": {"$ref": "#/$defs/gate_state"},
        "alias_existence": {"$ref": "#/$defs/gate_state"},
        "alias_selectability": {"$ref": "#/$defs/gate_state"},
        "animation": {"$ref": "#/$defs/gate_state"},
        "event": {"$ref": "#/$defs/gate_state"},
        "provider": {"$ref": "#/$defs/gate_state"},
        "native": {"$ref": "#/$defs/gate_state"},
        "runtime": {"$ref": "#/$defs/gate_state"}
      }
    },
    "matrix_row": {
      "type": "object", "additionalProperties": false,
      "required": ["pairing_id", "mode", "orientation", "route_id", "route_status", "gates"],
      "properties": {
        "pairing_id": {"$ref": "#/$defs/text"},
        "mode": {"$ref": "#/$defs/text"},
        "orientation": {"$ref": "#/$defs/text"},
        "route_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
        "route_status": {"enum": ["resolved", "unresolved", "failed"]},
        "gates": {"$ref": "#/$defs/gates"}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "source", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 128},
        "source": {"$ref": "#/$defs/text"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["node_count", "edge_count", "matrix_row_count", "unknown_edge_count", "coverage_gap_count"],
      "properties": {
        "node_count": {"type": "integer", "minimum": 1, "maximum": 200000},
        "edge_count": {"type": "integer", "minimum": 0, "maximum": 500000},
        "matrix_row_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "unknown_edge_count": {"type": "integer", "minimum": 0, "maximum": 500000},
        "coverage_gap_count": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    }
  }
}
