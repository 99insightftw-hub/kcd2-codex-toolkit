{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/combat-route-preflight-v1.schema.json",
  "title": "KCD2 combat route preflight report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "summary", "route_matrix", "unresolved_gates", "unrelated_preservation"],
  "properties": {
    "schema_version": {"const": "kcd2.combat-route-preflight.v1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "status": {"enum": ["PASS", "FAIL", "capture_inconclusive"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_count", "required_route_count", "resolved_route_count", "unresolved_gate_count"],
      "properties": {
        "pairing_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "required_route_count": {"type": "integer", "minimum": 1, "maximum": 262144},
        "resolved_route_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "unresolved_gate_count": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    },
    "route_matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 262144,
      "items": {"$ref": "#/$defs/route_row"}
    },
    "unresolved_gates": {
      "type": "array",
      "maxItems": 1048576,
      "items": {"$ref": "#/$defs/gate"}
    },
    "unrelated_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parent_contamination_detected", "undeclared_change_count", "identical_member_count"],
      "properties": {
        "status": {"type": ["string", "null"], "maxLength": 64},
        "parent_contamination_detected": {"type": ["boolean", "null"]},
        "undeclared_change_count": {"type": ["integer", "null"], "minimum": 0},
        "identical_member_count": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "$defs": {
    "bounded_string": {"type": "string", "minLength": 1, "maxLength": 1024},
    "route_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_id", "mode", "orientation", "route_id", "status"],
      "properties": {
        "pairing_id": {"$ref": "#/$defs/bounded_string"},
        "mode": {"$ref": "#/$defs/bounded_string"},
        "orientation": {"$ref": "#/$defs/bounded_string"},
        "route_id": {"type": ["string", "null"], "maxLength": 1024},
        "status": {"enum": ["resolved", "unresolved", "failed"]},
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table_row", "fragment_guid", "adb", "tags"],
          "properties": {
            "table_row": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
            "fragment_guid": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
            "adb": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
            "tags": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/bounded_string"}}
          }
        },
        "active_path": {"$ref": "#/$defs/bounded_string"},
        "active_winner_provider_id": {"type": ["string", "null"], "maxLength": 1024},
        "expected_winner_provider_id": {"$ref": "#/$defs/bounded_string"},
        "evidence_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/bounded_string"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope", "detail", "severity", "evidence_layer"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 128},
        "scope": {"$ref": "#/$defs/bounded_string"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 4096},
        "severity": {"enum": ["fail", "inconclusive"]},
        "evidence_layer": {"const": "static"}
      }
    }
  }
}
