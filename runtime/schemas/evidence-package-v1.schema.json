{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/evidence-package-v1.schema.json",
  "title": "KCD2 durable evidence package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "created_at", "mode", "producer", "source_package_ids", "claims", "evidence", "contradictions", "coverage", "validation", "artifacts", "limits"],
  "properties": {
    "schema_version": {"const": "kcd2.evidence-package.v1"},
    "package_id": {"type": "string", "pattern": "^evidence-package:sha256:[A-Fa-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "mode": {"enum": ["sanitized", "reviewable_full"]},
    "producer": {"type": "object", "additionalProperties": false, "required": ["tool_id", "version", "source_sha256"], "properties": {"tool_id": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
    "source_package_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-package:sha256:[A-Fa-f0-9]{64}$"}},
    "claims": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "status", "evidence_grade", "evidence_boundary", "evidence_refs", "contradiction_refs"], "properties": {"claim_id": {"type": "string", "minLength": 1, "maxLength": 256}, "statement": {"type": "string", "minLength": 1, "maxLength": 8000}, "status": {"enum": ["supported", "contradicted", "inconclusive", "not_evaluated"]}, "evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "unknown"]}, "evidence_boundary": {"enum": ["static", "runtime", "user_confirmed", "causal", "mixed"]}, "evidence_refs": {"$ref": "#/$defs/reference_list"}, "contradiction_refs": {"$ref": "#/$defs/reference_list"}}}},
    "evidence": {"type": "array", "maxItems": 50000, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_kind", "source_sha256", "locator", "collected_at", "native_location", "excerpt", "proprietary_payload_included"], "properties": {"evidence_id": {"type": "string", "minLength": 1, "maxLength": 512}, "evidence_kind": {"enum": ["static", "runtime", "user_confirmed", "causal"]}, "source_sha256": {"$ref": "#/$defs/sha256"}, "locator": {"type": "string", "minLength": 1, "maxLength": 4096}, "collected_at": {"type": "string", "format": "date-time", "maxLength": 64}, "native_location": {"type": ["object", "null"], "additionalProperties": false, "required": ["module_sha256", "address_kind", "value"], "properties": {"module_sha256": {"$ref": "#/$defs/sha256"}, "address_kind": {"enum": ["rva", "offset"]}, "value": {"type": "string", "pattern": "^0x[A-Fa-f0-9]{1,16}$"}}}, "excerpt": {"type": ["object", "null"], "additionalProperties": false, "required": ["encoding", "content", "bytes", "sha256"], "properties": {"encoding": {"enum": ["utf-8", "base64"]}, "content": {"type": "string", "maxLength": 65536}, "bytes": {"type": "integer", "minimum": 0, "maximum": 65536}, "sha256": {"$ref": "#/$defs/sha256"}}}, "proprietary_payload_included": {"type": "boolean", "default": false}}}},
    "contradictions": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["contradiction_id", "claim_refs", "evidence_refs", "resolution_state", "reason"], "properties": {"contradiction_id": {"type": "string", "minLength": 1, "maxLength": 256}, "claim_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "evidence_refs": {"$ref": "#/$defs/reference_list"}, "resolution_state": {"enum": ["open", "resolved", "superseded"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 4000}}}},
    "coverage": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["scope", "state", "files_considered", "bytes_considered", "limits_reached", "exclusions"], "properties": {"scope": {"type": "string", "minLength": 1, "maxLength": 1024}, "state": {"enum": ["complete", "complete_for_requested_scope", "partial_limit_reached", "stale", "unknown"]}, "files_considered": {"type": "integer", "minimum": 0, "maximum": 10000000}, "bytes_considered": {"type": "integer", "minimum": 0, "maximum": 1099511627776}, "limits_reached": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "exclusions": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["state", "validator_id", "validated_at", "checks"], "properties": {"state": {"enum": ["valid", "invalid", "inconclusive", "not_validated"]}, "validator_id": {"type": "string", "minLength": 1, "maxLength": 256}, "validated_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 64}, "checks": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["code", "status", "message"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}, "status": {"enum": ["pass", "fail", "inconclusive", "not_run"]}, "message": {"type": "string", "maxLength": 4000}}}}}},
    "artifacts": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["logical_path", "sha256", "bytes", "media_type", "included"], "properties": {"logical_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}, "media_type": {"type": "string", "minLength": 1, "maxLength": 256}, "included": {"type": "boolean"}}}},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "reference_list": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_claims", "max_evidence", "max_contradictions", "max_artifacts", "max_excerpt_bytes", "max_package_bytes", "max_string_chars"], "properties": {"max_claims": {"type": "integer", "minimum": 1, "default": 1000, "maximum": 10000}, "max_evidence": {"type": "integer", "minimum": 1, "default": 5000, "maximum": 50000}, "max_contradictions": {"type": "integer", "minimum": 0, "default": 1000, "maximum": 10000}, "max_artifacts": {"type": "integer", "minimum": 0, "default": 1000, "maximum": 10000}, "max_excerpt_bytes": {"type": "integer", "minimum": 0, "default": 4096, "maximum": 65536}, "max_package_bytes": {"type": "integer", "minimum": 1024, "default": 67108864, "maximum": 1073741824}, "max_string_chars": {"type": "integer", "minimum": 1, "default": 4096, "maximum": 65536}}}
  }
}
