{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/environment-profile-v2.schema.json",
  "title": "KCD2 environment profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "compatibility_profile_id",
    "created_at",
    "components",
    "repositories",
    "plugins",
    "catalog_fingerprint",
    "discovery_targets",
    "workflows"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.environment-profile.v2"},
    "profile_id": {"$ref": "#/$defs/text"},
    "compatibility_profile_id": {"$ref": "#/$defs/text"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "components": {
      "type": "array",
      "minItems": 9,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/component"}
    },
    "repositories": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/repository"}
    },
    "plugins": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/plugin"}
    },
    "catalog_fingerprint": {"$ref": "#/$defs/sha256"},
    "discovery_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_versions", "plugin_manifests", "catalogs"],
      "properties": {
        "component_versions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/component_version_target"}
        },
        "plugin_manifests": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/plugin_manifest_target"}
        },
        "catalogs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/catalog_target"}
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/workflow"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "nullable_text": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2048
    },
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "evidence"],
      "properties": {
        "status": {"enum": ["not_required", "not_run", "passed", "failed"]},
        "checked_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "maxLength": 64
        },
        "evidence": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_type",
        "required",
        "path",
        "interpreter_scope",
        "expected",
        "observed",
        "checks",
        "capability_level"
      ],
      "properties": {
        "component_id": {
          "enum": [
            "ghidra",
            "java",
            "x64dbg",
            "compiler",
            "kcse",
            "python_current",
            "pyghidra_isolated",
            "game",
            "whgame"
          ]
        },
        "component_type": {
          "enum": [
            "tool",
            "runtime",
            "python_interpreter",
            "game_executable",
            "game_module"
          ]
        },
        "required": {"type": "boolean"},
        "path": {"$ref": "#/$defs/text"},
        "interpreter_scope": {"enum": ["current", "isolated", null]},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": {"$ref": "#/$defs/text"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_present", "version", "sha256"],
          "properties": {
            "path_present": {"type": "boolean"},
            "version": {"$ref": "#/$defs/nullable_text"},
            "sha256": {"$ref": "#/$defs/nullable_sha256"}
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["launch", "provider", "catalog", "version_profile"],
          "properties": {
            "launch": {"$ref": "#/$defs/check"},
            "provider": {"$ref": "#/$defs/check"},
            "catalog": {"$ref": "#/$defs/check"},
            "version_profile": {"$ref": "#/$defs/check"}
          }
        },
        "capability_level": {
          "enum": [
            "PATH_PRESENT",
            "LAUNCH_VERIFIED",
            "PROVIDER_CONNECTED",
            "TOOL_CATALOG_VISIBLE",
            "VERSION_PROFILE_MATCHED",
            "WORKFLOW_ELIGIBLE",
            "UNAVAILABLE_OPTIONAL",
            "UNAVAILABLE_REQUIRED"
          ]
        }
      }
    },
    "component_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ghidra",
          "java",
          "x64dbg",
          "compiler",
          "kcse",
          "python_current",
          "pyghidra_isolated",
          "game",
          "whgame"
        ]
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "commit", "tree_sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "path": {"$ref": "#/$defs/text"},
        "commit": {"$ref": "#/$defs/nullable_text"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "manifest_sha256"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component_version_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "path", "format"],
      "properties": {
        "component_id": {
          "enum": [
            "ghidra", "java", "x64dbg", "compiler", "kcse", "python_current",
            "pyghidra_isolated", "game", "whgame"
          ]
        },
        "path": {"$ref": "#/$defs/text"},
        "format": {"enum": ["text", "json_version"]}
      }
    },
    "plugin_manifest_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "path"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/text"},
        "path": {"$ref": "#/$defs/text"}
      }
    },
    "catalog_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "path"],
      "properties": {
        "catalog_id": {"$ref": "#/$defs/text"},
        "path": {"$ref": "#/$defs/text"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "required_components", "optional_components"],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/text"},
        "required_components": {
          "allOf": [
            {"$ref": "#/$defs/component_set"},
            {"minItems": 1}
          ]
        },
        "optional_components": {"$ref": "#/$defs/component_set"}
      }
    }
  }
}
