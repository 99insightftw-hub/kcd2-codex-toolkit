{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/build-spec-v1.schema.json",
  "title": "KCD2 declarative candidate build specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "created_at", "mod", "parent", "allowed_changes", "inputs", "packaging", "external_components", "lifecycle_intent", "limits"],
  "properties": {
    "schema_version": {"enum": ["kcd2.build-spec.v1", "kcd2.build-spec.v2"]},
    "spec_id": {"type": "string", "pattern": "^build-spec:sha256:[A-Fa-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "mod": {"type": "object", "additionalProperties": false, "required": ["mod_id", "folder_name_exact", "human_aliases"], "properties": {"mod_id": {"type": "string", "pattern": "^[a-z0-9_]{1,200}$"}, "folder_name_exact": {"type": "string", "minLength": 1, "maxLength": 260}, "human_aliases": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "manifest_metadata": {"type": "object", "additionalProperties": false, "required": ["candidate_number", "load_order_identity", "name", "description_template", "author", "created_on"], "properties": {"candidate_number": {"type": "integer", "minimum": 100, "maximum": 999}, "load_order_identity": {"type": "string", "pattern": "^[a-z0-9_]{1,200}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "description_template": {"type": "string", "minLength": 1, "maxLength": 4096}, "author": {"type": "string", "minLength": 1, "maxLength": 1024}, "created_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}},
    "parent": {"type": "object", "additionalProperties": false, "required": ["mode", "candidate_id", "artifact_sha256", "evidence_refs"], "properties": {"mode": {"enum": ["new_candidate", "derived_candidate"]}, "candidate_id": {"type": ["string", "null"], "pattern": "^cand:sha256:[A-Fa-f0-9]{64}$"}, "artifact_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "evidence_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}}},
    "variant_selection": {"type": "object", "additionalProperties": false, "required": ["schema_version", "selection_id", "portfolio_registry_id", "groups", "validation"], "properties": {"schema_version": {"const": "kcd2.variant-selection.v1"}, "selection_id": {"type": "string", "pattern": "^variant-selection:sha256:[a-f0-9]{64}$"}, "portfolio_registry_id": {"type": "string", "pattern": "^registry:sha256:[a-f0-9]{64}$"}, "groups": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "additionalProperties": {}, "maxProperties": 4, "propertyNames": {"pattern": "^(group_id|rule|members|selected_member_ids)$"}}}, "validation": {"const": "VALID"}}},
    "allowed_changes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["change_kind", "logical_path", "record_selector", "expected_parent_sha256"], "properties": {"change_kind": {"enum": ["add_member", "replace_member", "remove_member", "patch_record", "add_external_component", "remove_external_component"]}, "logical_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "record_selector": {"type": ["string", "null"], "maxLength": 1024}, "expected_parent_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}}}},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/file_identity"}},
    "packaging": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_source", "profile_sha256", "archive_format", "compression_policy"], "properties": {"profile_id": {"type": "string", "minLength": 1, "maxLength": 256}, "profile_source": {"enum": ["explicit", "parent_inherited"]}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "archive_format": {"const": "zip_pak"}, "compression_policy": {"enum": ["stored", "deflated", "mixed", "inherit_exact"]}}},
    "external_components": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["role", "logical_path", "sha256", "bytes", "required_at_runtime"], "properties": {"role": {"type": "string", "minLength": 1, "maxLength": 128}, "logical_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}, "required_at_runtime": {"type": "boolean"}}}},
    "lifecycle_intent": {"enum": ["build_static_validation_only", "package_validation_requested"]},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "file_identity": {"type": "object", "additionalProperties": false, "required": ["role", "logical_path", "sha256", "bytes"], "properties": {"role": {"enum": ["source", "parent_artifact", "manifest", "configuration", "toolchain_lock"]}, "logical_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}, "variant_member_id": {"type": ["string", "null"], "pattern": "^variant-member:sha256:[a-f0-9]{64}$"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_inputs", "max_allowed_changes", "max_external_components", "max_path_chars", "max_input_bytes", "max_output_bytes"], "properties": {"max_inputs": {"type": "integer", "minimum": 1, "default": 1024, "maximum": 4096}, "max_allowed_changes": {"type": "integer", "minimum": 1, "default": 1024, "maximum": 4096}, "max_external_components": {"type": "integer", "minimum": 0, "default": 64, "maximum": 256}, "max_path_chars": {"type": "integer", "minimum": 1, "default": 2048, "maximum": 4096}, "max_input_bytes": {"type": "integer", "minimum": 1, "default": 1073741824, "maximum": 1099511627776}, "max_output_bytes": {"type": "integer", "minimum": 1, "default": 1073741824, "maximum": 1099511627776}}}
  }
}
