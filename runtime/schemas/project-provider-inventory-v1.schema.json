{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/project-provider-inventory-v1.schema.json",
  "title": "KCD2 explicit-scope project/provider inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "registry_id", "evaluated_at", "requested_project_ids", "status", "projects", "coverage"],
  "properties": {
    "schema_version": {"const": "kcd2.project-provider-inventory.v1"},
    "inventory_id": {"type": "string", "pattern": "^project-inventory:sha256:[0-9a-f]{64}$"},
    "registry_id": {"type": "string", "pattern": "^registry:sha256:[0-9a-f]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "requested_project_ids": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/project_id"}
    },
    "status": {"enum": ["complete", "capture_inconclusive"]},
    "projects": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/project"}
    },
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "project_id": {"type": "string", "pattern": "^project:sha256:[0-9a-f]{64}$"},
    "state": {"enum": ["configured", "present", "loaded", "inactive", "malformed", "duplicate", "unknown"]},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "provider_id", "kind", "locator", "states", "sha256", "observed_at"],
      "properties": {
        "receipt_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "provider_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["LOCAL", "WORKSHOP", "SOURCE_PROJECT", "REFERENCE", "EXTERNAL_COMPONENT"]},
        "locator": {"$ref": "#/$defs/text"},
        "states": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
        "sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "observed_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "aliases", "states", "providers"],
      "properties": {
        "project_id": {"$ref": "#/$defs/project_id"},
        "aliases": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "states": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
        "providers": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/provider"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_id", "overall_status", "presence_claim_allowed", "absence_claim_allowed", "reason_codes"],
      "properties": {
        "coverage_id": {"$ref": "#/$defs/text"},
        "overall_status": {"enum": ["COMPLETE", "COMPLETE_FOR_REQUESTED_SCOPE", "PARTIAL_LIMIT_REACHED", "PARTIAL_STALE", "INCONCLUSIVE", "UNAVAILABLE"]},
        "presence_claim_allowed": {"type": "boolean"},
        "absence_claim_allowed": {"type": "boolean"},
        "reason_codes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    }
  },
  "$comment": "PORT-002 introduces a new receipt-oriented result. It does not alter portfolio-registry-v1 or reinterpret installed-state-reconciliation-v1."
}
