{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/ui-runtime-adapter-receipt-v1.schema.json",
  "title": "KCD2 coverage-qualified UI/GFx runtime adapter receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "experiment_id", "active_snapshot_id",
    "candidate_provider_id", "input_sha256", "status", "evidence_layer",
    "event_count", "event_counts", "conflicts", "provider_resolution", "instances",
    "focus", "input_ownership", "aspect", "listeners", "fallbacks", "cleanup",
    "limits", "reason_codes", "permitted_claims"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.ui-runtime-adapter-receipt.v1"},
    "session_id": {"$ref": "#/$defs/text"},
    "experiment_id": {"$ref": "#/$defs/text"},
    "active_snapshot_id": {"$ref": "#/$defs/text"},
    "candidate_provider_id": {"$ref": "#/$defs/text"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "capture_inconclusive"]},
    "evidence_layer": {"const": "runtime_observed"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_counts": {
      "type": "object", "minProperties": 1, "maxProperties": 14,
      "propertyNames": {"enum": [
        "RESOURCE_SELECTED", "RESOURCE_FALLBACK", "ON_SHOW", "ON_HIDE", "ON_UNLOAD",
        "FOCUS_ACQUIRED", "FOCUS_LOST", "FOCUS_RESTORED", "INPUT_ACQUIRED",
        "INPUT_RELEASED", "ASPECT_APPLIED", "LISTENER_REGISTERED", "LISTENER_REMOVED",
        "SESSION_CLEANUP"
      ]},
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4096}
    },
    "conflicts": {"$ref": "#/$defs/conflicts"},
    "provider_resolution": {"$ref": "#/$defs/provider_resolution"},
    "instances": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/instance"}
    },
    "focus": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "restored_owner_id"],
      "properties": {
        "status": {"enum": ["restored", "unresolved"]},
        "restored_owner_id": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "input_ownership": {"$ref": "#/$defs/binary_status"},
    "aspect": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"enum": ["applied", "unresolved"]}}
    },
    "listeners": {
      "type": "object", "additionalProperties": false,
      "required": ["registered_count", "active_count"],
      "properties": {
        "registered_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "active_count": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "fallbacks": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/fallback"}
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["session_state", "active_instances", "active_listeners"],
      "properties": {
        "session_state": {"$ref": "#/$defs/text"},
        "active_instances": {"type": "integer", "minimum": 0, "maximum": 4096},
        "active_listeners": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_events", "maximum_payload_bytes", "maximum_resources"],
      "properties": {
        "maximum_events": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximum_payload_bytes": {"type": "integer", "minimum": 64, "maximum": 4096},
        "maximum_resources": {"const": 4096}
      }
    },
    "reason_codes": {
      "type": "array", "maxItems": 13, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "permitted_claims": {
      "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1024},
    "nullable_text": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "binary_status": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"enum": ["released", "unresolved"]}}
    },
    "conflicts": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "observed_count", "absence_claim_valid", "conclusion"],
      "properties": {
        "status": {"enum": ["complete", "issues_found", "capture_inconclusive"]},
        "observed_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "absence_claim_valid": {"type": "boolean"},
        "conclusion": {"$ref": "#/$defs/text"}
      }
    },
    "provider_resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "candidate_provider_id", "resources"],
      "properties": {
        "status": {"enum": ["complete", "issues_found", "capture_inconclusive"]},
        "candidate_provider_id": {"$ref": "#/$defs/text"},
        "resources": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {"$ref": "#/$defs/resource"}
        }
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": [
        "resource_id", "kind", "canonical_path", "symbol_name", "required",
        "fallback_resource_id", "winner_provider_id", "exact_active_winner",
        "absence_claim_valid", "status", "reason_codes"
      ],
      "properties": {
        "resource_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["movie", "symbol", "texture"]},
        "canonical_path": {"$ref": "#/$defs/text"},
        "symbol_name": {"$ref": "#/$defs/nullable_text"},
        "required": {"type": "boolean"},
        "fallback_resource_id": {"$ref": "#/$defs/nullable_text"},
        "winner_provider_id": {"$ref": "#/$defs/nullable_text"},
        "exact_active_winner": {"type": "boolean"},
        "absence_claim_valid": {"type": "boolean"},
        "status": {"enum": [
          "exact_active_winner", "fallback_available", "candidate_not_winner",
          "capture_inconclusive"
        ]},
        "reason_codes": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instance_id", "resource_id", "shown", "hidden", "unloaded",
        "previous_focus_owner_id", "focus_owner_id", "focus_restored_owner_id",
        "focus_acquired", "focus_lost", "input_owner_id", "input_released",
        "aspect_ratio", "aspect_mode"
      ],
      "properties": {
        "instance_id": {"$ref": "#/$defs/text"},
        "resource_id": {"$ref": "#/$defs/text"},
        "shown": {"type": "boolean"},
        "hidden": {"type": "boolean"},
        "unloaded": {"type": "boolean"},
        "previous_focus_owner_id": {"$ref": "#/$defs/nullable_text"},
        "focus_owner_id": {"$ref": "#/$defs/nullable_text"},
        "focus_restored_owner_id": {"$ref": "#/$defs/nullable_text"},
        "focus_acquired": {"type": "boolean"},
        "focus_lost": {"type": "boolean"},
        "input_owner_id": {"$ref": "#/$defs/nullable_text"},
        "input_released": {"type": "boolean"},
        "aspect_ratio": {"$ref": "#/$defs/nullable_text"},
        "aspect_mode": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "fallback": {
      "type": "object", "additionalProperties": false,
      "required": [
        "from_resource_id", "to_resource_id", "reason", "to_winner_provider_id"
      ],
      "properties": {
        "from_resource_id": {"$ref": "#/$defs/text"},
        "to_resource_id": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "to_winner_provider_id": {"$ref": "#/$defs/text"}
      }
    }
  }
}
