{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kcd2.toolchain/schemas/probe-result-validity-v1.schema.json",
  "title": "KCD2 probe result validity audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "session_id", "checks", "event_family_saturation", "verdict", "reasons", "permitted_runtime_claims"],
  "properties": {
    "schema_version": {"const": "kcd2.probe-result-validity.v1"},
    "probe_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["boot_ok", "install_ok", "game_fingerprint_match", "deployment_binding_exact", "module_base_emitted", "unfiltered_queries_observed", "record_layout_valid", "identity_filter_valid", "positive_control_or_population", "log_complete", "no_dropped_events", "user_state_confirmed", "correlation_contract_valid"],
      "properties": {
        "boot_ok": {"type": "boolean"},
        "install_ok": {"type": "boolean"},
        "game_fingerprint_match": {"type": "boolean"},
        "deployment_binding_exact": {"type": "boolean"},
        "module_base_emitted": {"type": "boolean"},
        "unfiltered_queries_observed": {"type": "boolean"},
        "record_layout_valid": {"type": "boolean"},
        "identity_filter_valid": {"type": "boolean"},
        "positive_control_or_population": {"type": "boolean"},
        "log_complete": {"type": "boolean"},
        "no_dropped_events": {"type": "boolean"},
        "user_state_confirmed": {"type": "boolean"},
        "correlation_contract_valid": {"type": "boolean"}
      }
    },
    "event_family_saturation": {
      "type": "object", "maxProperties": 128,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["observed", "limit", "reached"],
        "properties": {
          "observed": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1},
          "reached": {"type": "boolean"}
        }
      }
    },
    "verdict": {"enum": ["positive_observation", "confirmed_negative_in_covered_scope", "capture_inconclusive", "not_evaluated"]},
    "reasons": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "permitted_runtime_claims": {
      "type": "array", "maxItems": 256,
      "items": {"enum": ["query_observed", "candidate_population_observed", "predicate_rejection_observed", "row_not_enumerated", "row_survived_not_selected", "action_creation_failed", "native_action_committed", "animation_started", "outcome_observed", "none"]}
    },
    "audit_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "confirmed_negative_in_covered_scope"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "boot_ok": {"const": true},
              "install_ok": {"const": true},
              "game_fingerprint_match": {"const": true},
              "deployment_binding_exact": {"const": true},
              "module_base_emitted": {"const": true},
              "unfiltered_queries_observed": {"const": true},
              "record_layout_valid": {"const": true},
              "identity_filter_valid": {"const": true},
              "positive_control_or_population": {"const": true},
              "log_complete": {"const": true},
              "no_dropped_events": {"const": true},
              "user_state_confirmed": {"const": true},
              "correlation_contract_valid": {"const": true}
            }
          },
          "event_family_saturation": {
            "additionalProperties": {
              "properties": {"reached": {"const": false}},
              "required": ["reached"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"verdict": {"const": "capture_inconclusive"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "reasons": {"minItems": 1},
          "permitted_runtime_claims": {
            "not": {"contains": {"const": "row_not_enumerated"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permitted_runtime_claims": {"contains": {"const": "row_not_enumerated"}}
        },
        "required": ["permitted_runtime_claims"]
      },
      "then": {
        "properties": {"verdict": {"const": "confirmed_negative_in_covered_scope"}}
      }
    }
  ]
}
