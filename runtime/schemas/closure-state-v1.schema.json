{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/kcd2/closure-state-v1.schema.json",
  "title": "KCD2 generated production and critique closure state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "source_backlog",
    "release_receipt",
    "release_components",
    "critique_closure",
    "operationally_unresolved"
  ],
  "properties": {
    "$schema": {"const": "https://schemas.local/kcd2/closure-state-v1.schema.json"},
    "schema_version": {"const": "kcd2.closure-state.v1"},
    "source_backlog": {"type": "string", "pattern": "^KCD2_TOOLCHAIN_IMPLEMENTATION_BACKLOG_[^/\\\\]+\\.json$"},
    "release_receipt": {"$ref": "#/$defs/releaseReceipt"},
    "release_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/releaseComponent"}
    },
    "critique_closure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/closureItem"}
    },
    "operationally_unresolved": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {"type": "string"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "releaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "task_id", "classification", "source_revision", "source_auditability"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"},
        "task_id": {"const": "REL-602"},
        "classification": {"const": "non_live"},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "source_auditability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "statement"],
          "properties": {
            "state": {"enum": ["source_complete", "source_partial", "runtime_only", "unknown"]},
            "statement": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "releaseComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "package_sha256", "source_tree_sha256", "source_revision_state"],
      "properties": {
        "component": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_revision_state": {"enum": ["clean", "modified_worktree", "provided"]}
      }
    },
    "closureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source",
        "backlog",
        "implementation",
        "non_live_testing",
        "live_acceptance",
        "external_risk",
        "actual_resolution",
        "resolution_basis"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"type": "string", "minLength": 1, "maxLength": 512},
        "backlog": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {"enum": ["ready", "blocked", "in_progress", "done", "deferred", "blocked_external"]}
        },
        "implementation": {
          "allOf": [
            {"$ref": "#/$defs/evidenceGate"},
            {"properties": {"state": {"enum": ["complete", "partial", "missing"]}}}
          ]
        },
        "non_live_testing": {
          "allOf": [
            {"$ref": "#/$defs/evidenceGate"},
            {"properties": {"state": {"enum": ["passed", "failed", "not_run", "not_required"]}}}
          ]
        },
        "live_acceptance": {
          "allOf": [
            {"$ref": "#/$defs/evidenceGate"},
            {"properties": {"state": {"enum": ["passed", "failed", "not_run", "not_required"]}}}
          ]
        },
        "external_risk": {
          "allOf": [
            {"$ref": "#/$defs/evidenceGate"},
            {"properties": {"state": {"enum": ["none", "present", "unknown"]}}}
          ]
        },
        "actual_resolution": {"enum": ["resolved", "open", "blocked_external"]},
        "resolution_basis": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
