{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elfi0044.local/kcd2/schemas/native-relocation-comparison-v1.schema.json",
  "title": "KCD2 provisional cross-version native relocation comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_id", "created_at", "algorithm", "comparison_scope",
    "source_module",
    "target_module", "source_fingerprint_document_sha256",
    "target_fingerprint_document_sha256", "relocations", "promotion"
  ],
  "properties": {
    "schema_version": {"const": "kcd2.native-relocation-comparison.v1"},
    "comparison_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/date_time"},
    "algorithm": {
      "const": "kcd2.structural-fingerprint.normalized-bytes-callers-unwind.v1"
    },
    "comparison_scope": {"const": "reviewed_fingerprint_documents_only"},
    "source_module": {"$ref": "#/$defs/module"},
    "target_module": {"$ref": "#/$defs/module"},
    "source_fingerprint_document_sha256": {"$ref": "#/$defs/sha256"},
    "target_fingerprint_document_sha256": {"$ref": "#/$defs/sha256"},
    "relocations": {
      "type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/relocation"}
    },
    "promotion": {"$ref": "#/$defs/promotion"}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time", "maxLength": 64},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "timestamp", "image_size"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "timestamp": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "image_size": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_entry_id", "status", "semantic_name"],
      "properties": {
        "registry_entry_id": {"$ref": "#/$defs/id"},
        "status": {
          "enum": [
            "PROPOSED", "STATICALLY_SUPPORTED", "RUNTIME_SUPPORTED", "CONFIRMED",
            "SUPERSEDED", "REJECTED"
          ]
        },
        "semantic_name": {"$ref": "#/$defs/text"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "target_function_id", "target_rva", "status", "score", "matched_components",
        "structural_fingerprint_sha256"
      ],
      "properties": {
        "target_function_id": {"$ref": "#/$defs/id"},
        "target_rva": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "status": {"const": "PROVISIONAL"},
        "score": {"type": "integer", "minimum": 80, "maximum": 100},
        "matched_components": {
          "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["normalized_bytes", "caller_shape", "unwind_shape"]},
          "contains": {"const": "normalized_bytes"}
        },
        "structural_fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "relocation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_function_id", "source_rva", "source_structural_fingerprint_sha256",
        "source_interpretations", "outcome", "candidates"
      ],
      "properties": {
        "source_function_id": {"$ref": "#/$defs/id"},
        "source_rva": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "source_structural_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "source_interpretations": {
          "type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/interpretation"}
        },
        "outcome": {"enum": ["NO_CANDIDATE", "UNIQUE_PROVISIONAL", "AMBIGUOUS"]},
        "candidates": {
          "type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/candidate"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "NO_CANDIDATE"}}},
          "then": {"properties": {"candidates": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "UNIQUE_PROVISIONAL"}}},
          "then": {"properties": {"candidates": {"minItems": 1, "maxItems": 1}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "AMBIGUOUS"}}},
          "then": {"properties": {"candidates": {"minItems": 2}}}
        }
      ]
    },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "registry_write_performed", "independent_review_required"],
      "properties": {
        "status": {"const": "NOT_PROMOTED"},
        "registry_write_performed": {"const": false},
        "independent_review_required": {"const": true}
      }
    }
  }
}
